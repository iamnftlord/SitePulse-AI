# SitePulse AI - Backend Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# Ollama AI Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_REQUEST_TIMEOUT=60.0

# Crawler Settings
CRAWLER_TIMEOUT_SECONDS=15.0
CRAWLER_USER_AGENT=SitePulseAI-Auditor/1.0 (+https://github.com/SitePulseAI/sitepulse)
MAX_PAGE_SIZE_BYTES=10485760  # 10MB limit

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
